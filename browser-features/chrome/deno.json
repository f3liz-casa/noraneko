{
  "name": "@nora/features-chrome",
  "imports": {
    "tsdown": "npm:tsdown@^0.21.0",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.6",
    "@jsr/std__assert": "npm:@jsr/std__assert@^1.0.19",
    "@jsr/std__collections": "npm:@jsr/std__collections@^1.1.6",
    "@types/uuid": "npm:@types/uuid@^11.0.0",

    "birpc": "npm:birpc@^4.0.0",
    "es-toolkit": "npm:es-toolkit@^1.45.1",
    "@mobily/ts-belt": "npm:@mobily/ts-belt@^3.13.1",
    "i18next": "npm:i18next@^25.8.14",
    "io-ts": "npm:io-ts@^2.2.22",
    "preact": "npm:preact@^10.28.4",
    "preact/compat": "npm:preact@^10.28.4/compat",
    "preact/hooks": "npm:preact@^10.28.4/hooks",
    "@preact/signals": "npm:@preact/signals@^2.8.1",
    "uuid": "npm:uuid@^13.0.0",
    "chroma-js": "npm:chroma-js@^3.2.0",
    "@types/chroma-js": "npm:@types/chroma-js@^3.1.2",
    "@types/gecko": "jsr:@types/gecko",
    "valibot": "npm:valibot@^1.2.0",
    "@nora/solid-xul": "../shared/",
    "@nora/preact-xul": "../../libs/preact-xul/index.ts",
    "#features-chrome/": "./",
    "@lib": "./lib/mod.ts",
    "@lib/std": "./lib/std/mod.ts",
    "@lib/core": "./lib/core/mod.ts",
    "@lib/ui": "./lib/ui/mod.ts"
  },
  "tasks": {
    "build": "deno run -A npm:vite build",
    "build:nma": "deno task build && deno run -A ../../tools/scripts/build-nma.ts --source ./_dist"
  },
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": ["npm:vite/client", "jsr:@types/gecko"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "lint": {
    "rules": {
      "exclude": ["no-sloppy-imports", "no-window"]
    }
  },
  "exports": {
    "./static/mod.ts": "./static/mod.ts",
    "./features/mod.ts": "./features/mod.ts"
  }
}
