{
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "types": [
      "npm:vite/client",
      "jsr:@types/gecko"
    ],
    "skipLibCheck": true
  },
  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.6",
    "@std/fs": "jsr:@std/fs@^1.0.23",
    "birpc": "npm:birpc@^4.0.0",
    "oxlint": "npm:oxlint@^1.51.0",
    "tsdown": "npm:tsdown@^0.21.0"
  },
  "tasks": {
    "build": "deno run -A npm:tsdown"
  },
  "lint": {
    "exclude": [
      "./_dist/**/*"
    ]
  }
}
