{
  "license": "MPL-2.0",
  "links": ["libs/@types/gecko"],
  "workspace": ["./libs/*", "./browser-features/*", "./bridge/*"],
  "imports": {
    "@std/cli": "jsr:@std/cli@^1.0.28",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.23",
    "@std/path": "jsr:@std/path@^1.1.4",
    "#i18n/": "./i18n/",
    "#chrome/": "./chrome/",
    "#libs/": "./libs/",
    "#features-chrome/": "./browser-features/chrome/",
    "#modules/": "./browser-features/modules/",
    "#ui/": "./src/ui/",
    "#themes/": "./src/themes/",
    "#bridge-loader-features/": "./bridge/loader-features/",
    "@nora/shared/": "./browser-features/shared/",
    "@mobily/ts-belt": "npm:@mobily/ts-belt@^3.13.1",
    "jszip": "npm:jszip@^3.10.1",
    "diff": "npm:diff@^8.0.3",
    "@std/streams": "jsr:@std/streams@^1.0.17",
    "@std/toml": "npm:@jsr/std__toml@^1.0.11",
    "@preact/signals-core": "npm:@preact/signals-core@^1.13.0",
    "vite": "npm:rolldown-vite@^7.3.1"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "ESNext", "dom", "dom.asynciterable"],
    "checkJs": true
  },
  "exclude": [
    "tools/build/tasks/inject/wasm/nora-inject.js",
    "**/_dist/**/*",
    "libs/@types/gecko/**/*",
    "tools/build/tasks/inject/mixins/**/*",
    "chrome/**/*",
    "modules/**/*",
    "src/**/*",
    "node_modules/**/*"
  ],
  "tasks": {
    "feles-build": "deno run -A tools/feles-build.ts",
    "nma:build": "deno run --allow-read --allow-write --allow-env --allow-run tools/scripts/build-nma.ts"
  },
  "nodeModulesDir": "auto",
  "vendor": true
}
